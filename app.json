{
  "expo": {
    "name": "GamePal",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/gamepal/logo-pack/png/gamepal-app-icon-dark-1024.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.llllmithulllll.freegamehub"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19",
        "foregroundImage": "./assets/gamepal/gamepal-adaptive-foreground-1024.png",
        "monochromeImage": "./assets/gamepal/gamepal-adaptive-monochrome-1024.png"
      },
      "package": "com.llllmithulllll.freegamehub",
      "permissions": [
        "INTERNET"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/gamepal/logo-pack/png/gamepal-icon-color-transparent-1024.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GamePal to let you choose an optional profile picture or GIF.",
          "microphonePermission": false,
          "cameraPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/gamepal/logo-pack/png/gamepal-logo-color-transparent-1024.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B0F19",
          "dark": {
            "image": "./assets/gamepal/logo-pack/png/gamepal-logo-color-transparent-1024.png",
            "backgroundColor": "#0B0F19"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "debd7260-5d1f-46f3-accc-09eebd80d45d"
      }
    },
    "owner": "mithuwu"
  }
}
